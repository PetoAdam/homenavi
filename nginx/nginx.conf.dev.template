worker_processes 1;
events { worker_connections 1024; }
http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout 65;

    map "$scheme:$http_x_forwarded_proto" $homenavi_forwarded_proto {
        default $scheme;
        "http:https" https;
    }

    server {
        listen 80;
        server_name _;
        include /etc/nginx/routes.conf;
    }
}
