# Non-secret settings for the isolated Docker Compose CI smoke deployment.
HN_VERSION=latest
COMPOSE_ENV_FILE=./.env.ci
INTEGRATIONS_CONFIG_FILE=./integrations/config/installed.ci.yaml

API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8000
USER_SERVICE_PORT=8001
EMAIL_SERVICE_PORT=8002
PROFILE_PICTURE_SERVICE_PORT=8000
DEVICE_HUB_PORT=8090
ENTITY_REGISTRY_PORT=8095
ZIGBEE_ADAPTER_PORT=8091
MOCK_ADAPTER_PORT=8092
HISTORY_SERVICE_PORT=8093
AUTOMATION_SERVICE_PORT=8094
WEATHER_SERVICE_PORT=8095
FRONTEND_CONTAINER_PORT=80
NGINX_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
REDIS_PORT=6379
MQTT_PORT=1883

FRONTEND_HOST_PORT=15173
API_GATEWAY_HOST_PORT=18080
NGINX_HOST_PORT=18081
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
JAEGER_UI_HOST_PORT=17686
JAEGER_COLLECTOR_HOST_PORT=14269
MQTT_HOST_PORT=11883
MQTT_WS_HOST_PORT=19001

MQTT_BROKER_URL=mqtt://emqx:1883
MQTT_WEBSOCKET_UPSTREAM_URL=ws://emqx:8083/mqtt
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces

PROFILE_PICTURE_STORAGE_TYPE=s3
PROFILE_PICTURE_STORAGE_S3_ENDPOINT=http://minio:9000
PROFILE_PICTURE_STORAGE_S3_REGION=us-east-1
PROFILE_PICTURE_STORAGE_S3_BUCKET=profile-pictures
PROFILE_PICTURE_STORAGE_S3_ACCESS_KEY=homenavi-ci
PROFILE_PICTURE_STORAGE_S3_SECRET_KEY=homenavi-ci-test-secret-0123456789
PROFILE_PICTURE_STORAGE_S3_FORCE_PATH_STYLE=true

NGINX_MODE=dev
NGINX_CERT_ORIGIN=./nginx/certs/nginx.crt
NGINX_KEY_ORIGIN=./nginx/certs/nginx.key
POSTGRES_USER=homenavi
POSTGRES_PASSWORD=homenavi-ci-password
POSTGRES_DB=homenavi
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
LOG_LEVEL=info
HISTORY_INGEST_RETAINED=false
HISTORY_HDP_STATE_PREFIX=homenavi/hdp/device/state/
GOOGLE_OAUTH_CLIENT_ID=ci-client-id
GOOGLE_OAUTH_CLIENT_SECRET=ci-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost/api/auth/oauth/google/callback
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=ci@homenavi.test
FROM_NAME=Homenavi CI